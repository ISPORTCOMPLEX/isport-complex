# Skopíruj tento súbor ako .env a doplň vlastné hodnoty.
# Súbor .env sa NIKDY neposiela do gitu ani do chatu.

# Neon – Connect → Connection pooling ZAPNUTÝ (adresa obsahuje -pooler)
DATABASE_URL="postgresql://..."

# Neon – Connect → Connection pooling VYPNUTÝ (bez -pooler), používa sa na migrácie
DIRECT_URL="postgresql://..."

# Hlavný tajný kľúč (min. 32 znakov, náhodný). Z neho sa odvodia kľúče pre relácie, 2FA, CAPTCHA…
# Na Verceli iný ako lokálne. Po zmene sa všetci odhlásia a zapnuté 2FA prestane fungovať.
AUTH_SECRET=""

# Adresa webu pre odkazy v e-mailoch (lokálne http://localhost:3000)
APP_URL="http://localhost:3000"

# Resend – e-maily. Bez kľúča sa pri vývoji odkazy len vypíšu do terminálu.
RESEND_API_KEY=""
EMAIL_FROM="I-SPORT COMPLEX <onboarding@resend.dev>"

# Cloudinary – fotky webu (Settings → API Keys). Súbory sa ukladajú v Cloudinary, v databáze len odkazy.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Platba kartou online – predvolene vypnutá. Postup zapnutia: docs/PLATBY.md
#   off    = vypnuté (zákazník vidí „pripravujeme“)
#   mock   = testovacia brána bez peňazí (len localhost a Preview, na produkcii sa nezapne)
#   stripe = Stripe (karta, Apple Pay, Google Pay)
PAYMENTS_PROVIDER="off"
# Stripe → Developers → API keys (na Preview vždy sk_test_…, sk_live_ sa mimo produkcie ignoruje)
STRIPE_SECRET_KEY=""
# Stripe → Developers → Webhooks → endpoint /api/platby/webhook → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=""

# Denná údržba (pripomienky e-mailom, upratovanie) – náhodný reťazec, stačí na Verceli
CRON_SECRET=""
