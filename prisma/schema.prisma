// I-SPORT COMPLEX – databázová schéma
// Fáza 2: účty, overenie e-mailu, obnova hesla, 2FA, limity a bezpečnostné záznamy.
// Rezervácie, plochy a platby pribudnú vo fáze 3 a 4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  CLUB_MANAGER
  RECEPTION
  ACCOUNTANT
  ADMIN
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String?
  firstName             String
  lastName              String
  phone                 String?
  role                  Role      @default(CUSTOMER)
  emailVerifiedAt       DateTime?
  termsAcceptedAt       DateTime?
  ageConfirmedAt        DateTime?
  marketingOptIn        Boolean   @default(false)
  failedLoginCount      Int       @default(0)
  lockedUntil           DateTime?
  passwordChangedAt     DateTime?
  sessionsRevokedAt     DateTime?
  twoFactorSecretEnc    String?
  twoFactorEnabledAt    DateTime?
  twoFactorLastStep     Int?
  twoFactorBackupHashes String[]  @default([])
  bannedAt              DateTime?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  auditLogs  AuditLog[]
  authTokens AuthToken[]
  bookings   Booking[]
}

// Jednorazové odkazy z e-mailov (overenie e-mailu, obnova hesla). V DB je len odtlačok tokenu.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// Zdieľaný limit požiadaviek (pevné okno) – platí pre všetky inštancie na Verceli
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

// Pokusy o registráciu, prihlásenie a iné bezpečnostné udalosti (pre Administrácia → Bezpečnosť)
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String
  ok        Boolean
  reason    String?
  email     String?
  userId    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}

// Kto, čo a kedy urobil v administrácii
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  affected  Int?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

// ───────────────────────── Fáza 3: rezervácie ─────────────────────────

enum Area {
  FULL
  HALF_A
  HALF_B
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  ONSITE
  TRANSFER
  CARD
}

model Booking {
  id            String        @id @default(cuid())
  code          String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  area          Area
  startsAt      DateTime
  endsAt        DateTime
  hours         Int
  priceCents    Int
  status        BookingStatus @default(CONFIRMED)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod @default(ONSITE)
  paidAt        DateTime?
  contactName   String
  contactPhone  String
  teamName      String?
  note          String?
  qrToken       String        @unique
  checkedInAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledBy   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  slots BookingSlot[]

  @@index([startsAt])
  @@index([userId, startsAt])
  @@index([status, startsAt])
}

// Obsadené hodiny po polovicach ľadu (A, B). Unikátny index zaručí, že tú istú polovicu v tú istú hodinu
// nemôžu obsadiť dvaja naraz – ani pri súbežných rezerváciách. Celá plocha = obe polovice.
model BookingSlot {
  id        String   @id @default(cuid())
  slotStart DateTime
  half      String
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  blockId   String?
  block     Block?   @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([slotStart, half])
  @@index([bookingId])
  @@index([blockId])
}

// Blokovaný čas (úprava ľadu, údržba, turnaj) – zadáva administrácia.
model Block {
  id        String   @id @default(cuid())
  area      Area
  startsAt  DateTime
  endsAt    DateTime
  reason    String
  createdBy String?
  createdAt DateTime @default(now())

  slots BookingSlot[]

  @@index([startsAt])
}

// Nastavenia (cenník, otváracie hodiny…) ako JSON pod kľúčom.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}
