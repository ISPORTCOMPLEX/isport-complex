// I-SPORT COMPLEX – databázová schéma
// Fáza 2: účty, overenie e-mailu, obnova hesla, 2FA, limity a bezpečnostné záznamy.
// Rezervácie, plochy a platby pribudnú vo fáze 3 a 4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  CLUB_MANAGER
  RECEPTION
  ACCOUNTANT
  ADMIN
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  LOGIN_LINK // prihlásenie odkazom z e-mailu (prístupná alternatíva k CAPTCHA)
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String?
  firstName             String
  lastName              String
  phone                 String?
  role                  Role      @default(CUSTOMER)
  emailVerifiedAt       DateTime?
  termsAcceptedAt       DateTime?
  ageConfirmedAt        DateTime?
  marketingOptIn        Boolean   @default(false)
  failedLoginCount      Int       @default(0)
  lockedUntil           DateTime?
  passwordChangedAt     DateTime?
  sessionsRevokedAt     DateTime?
  twoFactorSecretEnc    String?
  twoFactorEnabledAt    DateTime?
  twoFactorLastStep     Int?
  twoFactorBackupHashes String[]  @default([])
  bannedAt              DateTime?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  auditLogs  AuditLog[]
  authTokens AuthToken[]
  bookings   Booking[]
  sessions   Session[]
}

// Fotky webu. Samotné súbory sú v Cloudinary – tu je len odkaz a popis.
model Photo {
  id          String   @id @default(cuid())
  publicId    String   @unique
  version     Int
  slot        String // časť webu: ladova-plocha, skyboxy, bufet, ihrisko, posilnovna, wellness, komplex
  alt         String   @default("")
  width       Int
  height      Int
  format      String
  bytes       Int
  sort        Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([slot, sort])
}

// Prihlásené zariadenia. Cookie nesie podpísaný JWT s id relácie; odhlásenie reláciu zruší aj na serveri,
// takže ukradnutá cookie po odhlásení už nefunguje.
model Session {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

// Jednorazové odkazy z e-mailov (overenie e-mailu, obnova hesla). V DB je len odtlačok tokenu.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// Zdieľaný limit požiadaviek (pevné okno) – platí pre všetky inštancie na Verceli
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

// Pokusy o registráciu, prihlásenie a iné bezpečnostné udalosti (pre Administrácia → Bezpečnosť)
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String
  ok        Boolean
  reason    String?
  email     String?
  userId    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}

// Kto, čo a kedy urobil v administrácii
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  affected  Int?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

// ───────────────────────── Fáza 3: rezervácie ─────────────────────────

enum Area {
  FULL
  HALF_A
  HALF_B
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PENDING // čaká na platbu kartou online (čas je podržaný do payDeadline)
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  ONSITE
  TRANSFER
  CARD
}

model Booking {
  id            String        @id @default(cuid())
  code          String        @unique
  number        Int           @unique @default(autoincrement()) // variabilný symbol pri prevode
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  guestEmail    String? // rezervácia vytvorená recepciou bez účtu
  createdById   String? // personál, ktorý rezerváciu zadal
  movedFromCode String? // presun z inej rezervácie
  reminderSentAt DateTime?
  area          Area
  startsAt      DateTime
  endsAt        DateTime
  hours         Int
  priceCents    Int // spolu: ľad + šatne
  showers       Int           @default(0) @map("lockerRooms") // sprchy po tréningu: 0 = nie, 1 = áno
  showerCents   Int           @default(0) @map("lockerCents") // cena za sprchy
  status        BookingStatus @default(CONFIRMED)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod @default(ONSITE)
  paidAt        DateTime?
  payDeadline   DateTime? // do kedy musí prísť platba kartou, inak sa rezervácia zruší
  refundedCents Int           @default(0)
  contactName   String
  contactPhone  String
  teamName      String?
  note          String?
  qrToken       String        @unique
  checkedInAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledBy   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  slots    BookingSlot[]
  payments Payment[]

  @@index([startsAt])
  @@index([userId, startsAt])
  @@index([status, startsAt])
  @@index([paymentStatus, payDeadline])
}

// ───────────────────────── Platby kartou online ─────────────────────────
// Brána je pripravená, ale vypnutá (PAYMENTS_PROVIDER=off). Postup zapnutia: docs/PLATBY.md.
// Číslo karty ani iné údaje o karte sa sem nikdy neukladajú – platbu spracúva brána na svojej stránke.

enum PaymentState {
  CREATED // platobná relácia vytvorená, zákazník platí
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELED
}

model Payment {
  id            String       @id @default(cuid())
  bookingId     String
  booking       Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  provider      String // stripe | mock | …
  sessionRef    String       @unique // id platobnej relácie u brány (Stripe: cs_…)
  intentRef     String?      @unique // id samotnej platby (Stripe: pi_…), potrebné na vrátenie peňazí
  amountCents   Int
  currency      String       @default("EUR")
  state         PaymentState @default(CREATED)
  refundedCents Int          @default(0)
  checkoutUrl   String?
  expiresAt     DateTime?
  paidAt        DateTime?
  failureReason String?
  livemode      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  refunds Refund[]

  @@index([bookingId])
  @@index([state, expiresAt])
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  providerRef String   @unique // Stripe: re_…
  amountCents Int
  reason      String?
  status      String // succeeded | pending | failed
  createdById String? // personál; null = automaticky (zrušenie zákazníkom)
  createdAt   DateTime @default(now())

  @@index([paymentId])
}

// Prijaté udalosti z brány – každú spracujeme práve raz (brány posielajú udalosti aj opakovane).
model PaymentEvent {
  id         String   @id // <provider>:<id udalosti>
  provider   String
  type       String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// Obsadené hodiny po polovicach ľadu (A, B). Unikátny index zaručí, že tú istú polovicu v tú istú hodinu
// nemôžu obsadiť dvaja naraz – ani pri súbežných rezerváciách. Celá plocha = obe polovice.
model BookingSlot {
  id        String   @id @default(cuid())
  slotStart DateTime
  half      String
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  blockId   String?
  block     Block?   @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([slotStart, half])
  @@index([bookingId])
  @@index([blockId])
}

// Blokovaný čas (úprava ľadu, údržba, turnaj) – zadáva administrácia.
model Block {
  id        String   @id @default(cuid())
  area      Area
  startsAt  DateTime
  endsAt    DateTime
  reason    String
  createdBy String?
  createdAt DateTime @default(now())

  slots BookingSlot[]

  @@index([startsAt])
}

// Nastavenia (cenník, otváracie hodiny…) ako JSON pod kľúčom.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ───────────────────────── Dopyty (kontakt, kluby) ─────────────────────────

enum InquiryType {
  CONTACT
  CLUB
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  DONE
  SPAM
}

model Inquiry {
  id           String        @id @default(cuid())
  type         InquiryType
  status       InquiryStatus @default(NEW)
  name         String
  email        String
  phone        String?
  organization String?
  subject      String?
  message      String
  details      Json?
  userId       String?
  ip           String?
  staffNote    String?
  handledById  String?
  handledAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
}

// Vlastná analytika návštevnosti bez cookies: žiadne IP adresy ani trvalé identifikátory.
// visitor = denný hash (soľ sa mení každý deň), takže návštevníka nemožno sledovať medzi dňami.
model PageView {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  path       String
  referrer   String? // len doména
  source     String? // utm_source alebo typ zdroja
  visitor    String
  device     String // mobile | tablet | desktop
  browser    String?
  os         String?
  country    String?
  durationMs Int?
  loggedIn   Boolean  @default(false)

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([visitor, createdAt])
}
